config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd4b:3258:6090::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	option ports 'wlan0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'wlan1'
	option proto 'dhcp'

config interface 'wan6'
	option device 'wlan1'
	option proto 'dhcpv6'

config interface 'wwan'
	option proto 'dhcp'
