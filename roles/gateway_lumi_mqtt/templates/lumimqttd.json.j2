{
"mqtt_host": "{{ mqtt_host }}",
"mqtt_port": 1883,
"mqtt_keepalive": 60,
"mqtt_user": "{{ mqtt_user }}",
"mqtt_user_pw": "{{ mqtt_pass }}",
"mqtt_retain": true,
"auto_discovery": false,
"topic": "lumi/{device_id}/",
"device_id": "0x{{ hub_mac }}_audio",
"connect_retries": 10,
"log_level": 3,
"readinterval": 1,
"treshold": 30,
"red_led": "/sys/class/leds/red/brightness",
"green_led": "/sys/class/leds/green/brightness",
"blue_led": "/sys/class/leds/blue/brightness",
"lux_file": "/sys/bus/iio/devices/iio:device0/in_voltage5_raw"
}
