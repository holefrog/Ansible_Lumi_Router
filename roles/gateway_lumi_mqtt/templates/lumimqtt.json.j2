{
  "mqtt_host": "{{ mqtt_host }}",
  "mqtt_port": {{ mqtt_port }},
  "mqtt_user": "{{ mqtt_user }}",
  "mqtt_password": "{{ mqtt_pass }}",
  "topic_root": "lumi/{device_id}",
  "auto_discovery": true,
  "sensor_retain": false,
  "sensor_threshold": 50,
  "sensor_debounce_period": 60,
  "legacy_color_mode": false,
  "light_transition_period": 1.0,
  "custom_commands": {
    "playmp3": "/usr/bin/mpg123 /music/{file} > /tmp/tmp_audio.log 2>&1",
    "playwav": "/usr/bin/aplay /music/{file} > /tmp/tmp_audio.log 2>&1",
    "set_vol": "/usr/bin/amixer set Master {vol}% > /tmp/tmp_audio.log 2>&1"
}
}