#!/bin/sh /etc/rc.common
# Ansible Managed - Squeezelite Init Script

START=99
STOP=1

USE_PROCD=1
PROG=/usr/bin/squeezelite

start_service() {
	procd_open_instance
	
	# 1. 智能启动包装器：冷启动(<60秒)休眠15秒避开声卡和网络风暴
	procd_set_param command /bin/sh -c '
		[ "$(cut -d. -f1 /proc/uptime)" -lt 60 ] && sleep 15
		exec "$0" "$@"
	' "$PROG" \
		-n "{{ squeezelite_name }}" \
		-M "SqueezeLite" \
		-o "default" \
		-m "{{ hub_mac[0:2] }}:{{ hub_mac[2:4] }}:{{ hub_mac[4:6] }}:{{ hub_mac[6:8] }}:{{ hub_mac[8:10] }}:{{ hub_mac[10:12] }}" \
		-a "{{ squeezelite_alsa_buffer }}:{{ squeezelite_alsa_period }}:{{ squeezelite_alsa_format }}:{{ squeezelite_alsa_mmap }}" \
		-b "2048:3763" \
		-s "{{ lms_host }}:3483"
	
	# 2. 将崩溃重试次数拉高到 120 次 (容忍长达 20 分钟的断网)
	procd_set_param respawn 3600 10 120
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	sleep 2
	start
}

restart() {
	reload_service
}