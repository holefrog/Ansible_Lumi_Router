#!/bin/sh /etc/rc.common
# Ansible Managed - Squeezelite Init Script

START=99
STOP=1

USE_PROCD=1
PROG=/usr/bin/squeezelite

start_service() {
	procd_open_instance
	
	# 直接硬编码由 Ansible 渲染好的参数
	procd_set_param command "$PROG" \
		-n "{{ squeezelite_name }}" \
		-M "SqueezeLite" \
		-o "default" \
		-a "{{ squeezelite_alsa_buffer }}:{{ squeezelite_alsa_period }}:{{ squeezelite_alsa_format }}:{{ squeezelite_alsa_mmap }}" \
		-b "2048:3763" \
		-s "{{ lms_host }}:3483"
	
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	sleep 2
	start
}

restart() {
	reload_service
}